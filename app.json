{
  "expo": {
    "name": "SEÑAS",
    "slug": "Senas_Danah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon~ios-marketing.png",
    "scheme": "senasappdev",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danahparis21.SenasApp",
      "icon": "./assets/images/AppIcon~ios-marketing.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsForMedia": true,
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/play_store_512.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.danahparis21.Senas_Danah"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/play_store_512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/play_store_512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true,
          "enableCoreMLDelegate": true
        }
      ],
      "expo-web-browser",
      "expo-video",
      "react-native-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://señas.tech/api",
      "storageUrl": "https://señas.tech/storage",
      "webUrl": "https://señas.tech",
      "router": {},
      "eas": {
        "projectId": "cbe9cf01-b410-4705-ae77-fb6e21703cb1"
      }
    }
  }
}
